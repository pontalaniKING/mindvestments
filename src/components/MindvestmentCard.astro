---
import EvidenceBadge from './EvidenceBadge.astro';
import { t } from '../i18n/ui';
import type { EvidenceGrade } from '../data/site';
import type { PillarId } from '../data/site';

interface Props {
  action: string;
  minutes?: number;
  difficulty?: 'Low' | 'Medium' | 'High';
  payoff: string;
  timeToEffect: string;
  evidence: EvidenceGrade;
  pillar: PillarId;
  href?: string;
  compact?: boolean;
}

const {
  action,
  minutes,
  difficulty = 'Low',
  payoff,
  timeToEffect,
  evidence,
  pillar,
  href,
  compact = false
} = Astro.props;

const MainTag = href ? 'a' : 'div';
---

<div
  class:list={['mv-card', { compact, linked: !!href }]}
  style={`--marker: var(--pillar-${pillar})`}
>
  <MainTag class="mv-card-main" href={href}>
    <p class="kicker">{t('card.kicker')}</p>
    <p class="action">{action}</p>

    <dl class="facts">
      {
        minutes !== undefined && (
          <div>
            <dt>{t('card.costs')}</dt>
            <dd>{minutes} {t('card.perDay')}</dd>
          </div>
        )
      }
      <div>
        <dt>{t('card.effort')}</dt>
        <dd>{t(`card.difficulty.${difficulty}`)}</dd>
      </div>
      <div>
        <dt>{t('card.gives')}</dt>
        <dd>{payoff}</dd>
      </div>
      <div>
        <dt>{t('card.felt')}</dt>
        <dd>{timeToEffect}</dd>
      </div>
    </dl>
  </MainTag>

  <div class="foot">
    <EvidenceBadge grade={evidence} />
  </div>
</div>

<style>
  .mv-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-inline-start: 3px solid var(--marker);
    border-radius: var(--radius);
    padding: var(--s3);
    text-decoration: none;
    color: var(--text);
  }

  .mv-card-main {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .linked {
    transition: border-color 160ms ease-out;
  }

  .linked:hover {
    border-color: var(--border-strong);
    border-inline-start-color: var(--marker);
    color: var(--text);
  }

  .kicker {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    margin: 0 0 var(--s1);
  }

  .action {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 0 0 var(--s3);
    max-width: 26ch;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s2) var(--s3);
    margin: 0 0 var(--s3);
    padding-top: var(--s2);
    border-top: 1px solid var(--border);
  }

  dt {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    margin-bottom: 0.15rem;
  }

  dd {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.4;
  }

  .foot {
    margin-top: auto;
    padding-top: var(--s2);
    border-top: 1px solid var(--border);
  }

  .compact .action {
    font-size: var(--fs-lg);
  }

  .compact .facts {
    grid-template-columns: 1fr;
    gap: var(--s1);
  }

  @media (max-width: 520px) {
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>