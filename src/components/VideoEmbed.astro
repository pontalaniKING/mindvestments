---
import { site } from '../data/site';
import { t } from '../i18n/ui';

interface Props {
  id: string;
  title: string;
  duration?: string;
}

const { id, title, duration } = Astro.props;
---

<figure class="video">
  <div class="frame">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${id}?rel=0`}
      title={title}
      loading="lazy"
      allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen></iframe>
  </div>
  <figcaption>
    <span>{title}{duration ? ` — ${duration}` : ''}</span>
    <a href={site.youtube}>{t('video.newEpisodes')}</a>
  </figcaption>
</figure>

<style>
  .video { margin: var(--s4) 0; }
  .frame { position: relative; aspect-ratio: 16 / 9; background: var(--charcoal); border-radius: var(--radius); overflow: hidden; }
  iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  figcaption { display: flex; justify-content: space-between; gap: var(--s2); flex-wrap: wrap; font-size: var(--fs-xs); color: var(--text-muted); padding-top: var(--s1); }
</style>
