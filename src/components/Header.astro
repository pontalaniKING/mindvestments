---
import { navCategories, site } from '../data/site';
import { t } from '../i18n/ui';

const currentPath = Astro.url.pathname;

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">{site.name}</a>

    <nav class="nav" aria-label="Main">
      {
        navCategories.map((cat) => (
          <a href={cat.href} class:list={['nav-link', { current: isCurrent(cat.href) }]}>
            {cat.label}
          </a>
        ))
      }
      <a href="/about" class:list={['nav-link', { current: isCurrent('/about') }]}>
        About
      </a>
    </nav>

    <div class="tools">
      <a class="icon-link" href="/search" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5" />
          <line x1="12.5" y1="12.5" x2="17" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </a>
      <a class="btn start" href="/start">{t('nav.startHere')}</a>
    </div>
  </div>
  <hr class="rule" />
</header>

<style>
  .bar {
    display: flex;
    align-items: center;
    gap: var(--s4);
    min-height: 76px;
  }

  .brand {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--text);
    white-space: nowrap;
  }

  .nav {
    display: flex;
    gap: var(--s4);
    margin-inline-end: auto;
    overflow-x: auto;
    scrollbar-width: none;
    font-family: var(--font-ui);
  }
  .nav::-webkit-scrollbar { display: none; }

  .nav-link {
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--text-muted);
    padding-block: 0.35rem;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  .nav-link:hover { color: var(--accent); }
  .nav-link.current { color: var(--text); border-bottom-color: var(--gold-accent); }

  .tools { display: flex; align-items: center; gap: var(--s3); }

  .icon-link {
    color: var(--text-muted);
    display: inline-flex;
    padding: 0.3rem;
  }
  .icon-link:hover { color: var(--accent); }

  .start { padding: 0.6rem 1.1rem; font-family: var(--font-ui); }

  @media (max-width: 820px) {
    .bar { flex-wrap: wrap; min-height: 0; padding-block: var(--s2); }
    .nav { order: 3; width: 100%; margin-inline-end: 0; gap: var(--s3); }
    .tools { margin-inline-start: auto; }
  }
</style>
