---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MindvestmentCard from '../components/MindvestmentCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { navCategories } from '../data/site';
import { t } from '../i18n/ui';
import { urlFor } from '../i18n/content';

const all = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const hero = all.find((a) => a.data.featured) ?? all[0];
const latest = all.filter((a) => a.id !== hero?.id).slice(0, 6);
const withVideo = all.find((a) => a.data.video);

const complaints = [
  { key: 'complaint.tired', href: '/sleep' },
  { key: 'complaint.cantSleep', href: '/sleep' },
  { key: 'complaint.wired', href: hero ? urlFor(hero) : '/sleep' },
  { key: 'complaint.stiff', href: '/move' },
  { key: 'complaint.noTime', href: '/start' },
  { key: 'complaint.dontKnow', href: '/start' }
];
---

<Base title={t('home.h1')}>
  <section class="wrap hero">
    <div class="hero-copy">
      <h1>{t('home.h1')}</h1>
      <p class="lede">{t('home.lede')}</p>
      <div class="cta">
        <a class="btn" href="/start">{t('home.ctaStart')}</a>
        <a class="btn btn-quiet" href="/sleep">{t('home.ctaSleep')}</a>
      </div>
      <p class="note">{t('home.note')}</p>
    </div>

    {
      hero && (
        <div class="hero-card">
          <MindvestmentCard
            action={hero.data.action}
            minutes={hero.data.minutes}
            difficulty={hero.data.difficulty}
            payoff={hero.data.payoff}
            timeToEffect={hero.data.timeToEffect}
            evidence={hero.data.evidence}
            pillar={hero.data.pillar}
            href={urlFor(hero)}
          />
        </div>
      )
    }
  </section>

  <hr class="wrap rule" />

  <section class="wrap section">
    <h2>{t('home.complaintsHeading')}</h2>
    <div class="complaints">
      {complaints.map((c) => <a class="complaint" href={c.href}>{t(c.key)}</a>)}
    </div>
  </section>

  <section class="wrap section">
    <h2>{t('home.pillarsHeading')}</h2>
    <div class="pillars">
      {
        navCategories.map((cat) => (
          <a class="pillar" href={cat.href} style={`--marker: var(--pillar-${cat.pillars[0]})`}>
            <span class="pillar-name">{t(`category.${cat.id}.label`)}</span>
            <span class="pillar-blurb">{t(`category.${cat.id}.blurb`)}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap section">
    <h2>{t('home.howHeading')}</h2>
    <ol class="steps measure">
      <li><h3>{t('home.step1Title')}</h3><p>{t('home.step1Body')}</p></li>
      <li><h3>{t('home.step2Title')}</h3><p>{t('home.step2Body')}</p></li>
      <li><h3>{t('home.step3Title')}</h3><p>{t('home.step3Body')}</p></li>
    </ol>
  </section>

  {
    withVideo && (
      <section class="wrap section">
        <h2>{t('home.watchHeading')}</h2>
        <p class="measure">{t('home.watchBody')}</p>
        <p><a href={urlFor(withVideo)}>{withVideo.data.video?.title}</a></p>
      </section>
    )
  }

  {
    latest.length > 0 && (
      <section class="wrap section">
        <h2>{t('home.latestHeading')}</h2>
        <div class="grid">
          {latest.map((a) => (
            <ArticleCard
              href={urlFor(a)}
              title={a.data.title}
              description={a.data.description}
              pillar={a.data.pillar}
              cluster={a.data.cluster}
              minutes={a.data.minutes}
              evidence={a.data.evidence}
              hasVideo={!!a.data.video}
              videoDuration={a.data.video?.duration}
              image={a.data.image}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="wrap section">
    <div class="trust">
      <h2>{t('home.trustHeading')}</h2>
      <p class="measure">{t('home.trustBody')}</p>
      <p><a href="/evidence">{t('home.trustLink')}</a></p>
    </div>
  </section>

  <section class="wrap section">
    <div class="news">
      <h2>{t('home.newsHeading')}</h2>
      <p>{t('home.newsBody')}</p>
      <p class="note">{t('home.newsNote')}</p>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: var(--s6); align-items: start; padding-block: var(--s7) var(--s6); }
  .hero h1 { font-size: var(--fs-4xl); max-width: 14ch; margin-bottom: var(--s3); }
  .hero .lede { max-width: 46ch; color: var(--text-muted); }
  .cta { display: flex; gap: var(--s2); flex-wrap: wrap; margin-top: var(--s4); }
  .note { font-size: var(--fs-xs); color: var(--text-muted); margin-top: var(--s2); }

  /*
    Six fixed items, so a fixed column count (rather than auto-fill/
    minmax) guarantees full, even rows at every breakpoint instead of
    leaving a leftover item to stretch or an empty gap on the last row:
    3x2 on desktop, 2x3 on tablet, 1x6 stacked on mobile.
  */
  .complaints {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .complaint { background: var(--bg); padding: var(--s3); text-decoration: none; font-family: var(--font-display); font-size: var(--fs-lg); color: var(--text); transition: background 160ms ease-out; }
  .complaint:hover { background: var(--surface); color: var(--accent); }

  .pillars { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: var(--s3); }
  .pillar { border-top: 3px solid var(--marker); padding-top: var(--s2); text-decoration: none; color: var(--text); display: block; }
  .pillar-name { display: block; font-family: var(--font-display); font-size: var(--fs-lg); }
  .pillar-blurb { display: block; font-size: var(--fs-sm); color: var(--text-muted); margin-top: 0.2rem; }
  .pillar-soon { display: inline-block; margin-top: var(--s1); font-size: var(--fs-xs); color: var(--text-muted); border: 1px dashed var(--border-strong); border-radius: 100px; padding: 0.1rem 0.5rem; }
  .pillar:hover .pillar-name { color: var(--accent); }

  /*
    Each <li> has three grid items once the ::before counter is counted:
    the number, the <h3>, and the <p>. With only two explicit columns,
    grid auto-placement put the number and heading on row 1 and then
    wrapped the paragraph alone onto row 2 in the 2.5rem number column —
    squeezing the description text into a ~40px column. Placing every
    item explicitly fixes that: number spans both rows in column 1,
    heading and description both sit in column 2.
  */
  .steps { list-style: none; padding: 0; counter-reset: step; }
  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.5rem minmax(280px, 500px);
    grid-template-rows: auto auto;
    column-gap: var(--s3);
    padding-block: var(--s3);
    border-top: 1px solid var(--border);
  }
  .steps li::before {
    content: counter(step);
    grid-column: 1;
    grid-row: 1 / span 2;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    color: var(--accent);
  }
  .steps h3 { grid-column: 2; grid-row: 1; margin-bottom: 0.2rem; font-size: var(--fs-lg); }
  .steps p { grid-column: 2; grid-row: 2; margin: 0; color: var(--text-muted); font-size: var(--fs-sm); }

  /*
    Fixed column counts here too, for the same reason as .complaints:
    the homepage always shows up to 6 "latest" articles, so 3/2/1 across
    breakpoints keeps every row full-width and evenly sized rather than
    stretching a short last row or leaving empty grid tracks beside it.
  */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s4) var(--s3);
  }

  .trust, .news { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--s5); }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; gap: var(--s4); padding-block: var(--s5) var(--s4); }
    .hero h1 { max-width: none; }
  }

  @media (max-width: 820px) {
    .complaints, .grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 520px) {
    .complaints, .grid { grid-template-columns: 1fr; }

    .steps li {
      grid-template-columns: 2.5rem 1fr;
      column-gap: var(--s2);
    }
    .steps h3,
    .steps p { grid-column: 2; max-width: none; }
  }
</style>
