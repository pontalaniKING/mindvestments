---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { t } from '../i18n/ui';
---

<Base title={t('about.title')} description={t('about.description')}>
  <section class="wrap layout">
    <div class="portrait">
      <div class="ph">{t('about.photoPlaceholder')}</div>
      <p class="cap">{t('about.photoCaption')}</p>
    </div>

    <div class="body prose">
      <h1>{t('about.h1')}</h1>
      <p class="lede">{t('about.lede')}</p>

      <h2>{t('about.whyHeading')}</h2>
      <p>{t('about.whyBody')}</p>

      <h2>{t('about.whoHeading')}</h2>
      <p>{t('about.whoBody')}</p>

      <h2>{t('about.fundedHeading')}</h2>
      <p>{t('about.fundedBody')}</p>

      <h2>{t('about.contactHeading')}</h2>
      <p>{t('about.contactBody')} <a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </section>
</Base>

<style>
  .layout { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: var(--s5); padding-block: var(--s6); align-items: start; }
  .ph { aspect-ratio: 4 / 5; display: grid; place-items: center; background: var(--surface); border: 1px dashed var(--border-strong); border-radius: var(--radius); color: var(--text-muted); font-size: var(--fs-sm); text-align: center; padding: var(--s2); }
  .cap { font-size: var(--fs-xs); color: var(--text-muted); margin-top: var(--s2); }
  .body h1 { font-size: var(--fs-4xl); }
  .body .lede { color: var(--text-muted); }

  @media (max-width: 820px) {
    .layout { grid-template-columns: 1fr; }
    .portrait { max-width: 240px; }
  }
</style>
