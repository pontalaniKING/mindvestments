---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { urlFor } from '../i18n/content';

const articles = await getCollection('articles', ({ data }) => !data.draft);

// A small static search index, built once at compile time. No client-side
// framework, no third-party search service — just the fields a reader
// would actually search on, matched with plain substring search in the
// browser. Fine at this content size; revisit if the catalog grows a lot.
const index = articles.map((a) => ({
  title: a.data.title,
  description: a.data.description,
  pillar: a.data.pillar,
  cluster: a.data.cluster,
  href: urlFor(a)
}));
---

<Base title="Search" description="Search Mindvestments articles.">
  <header class="wrap head">
    <h1>Search</h1>
    <p class="lede measure">Find an article by what it's about.</p>
  </header>

  <div class="wrap search-box">
    <label class="sr" for="q">Search articles</label>
    <input id="q" type="search" placeholder="Try “sleep”, “caffeine”, “strength”…" autocomplete="off" />
  </div>

  <div class="wrap section">
    <p id="count" class="count" aria-live="polite"></p>
    <ul id="results" class="results"></ul>
  </div>

  <script type="application/json" id="search-index" set:html={JSON.stringify(index)} />

  <script>
    const data = JSON.parse(document.getElementById('search-index')!.textContent || '[]') as {
      title: string;
      description: string;
      pillar: string;
      cluster: string;
      href: string;
    }[];

    const input = document.getElementById('q') as HTMLInputElement;
    const list = document.getElementById('results') as HTMLUListElement;
    const count = document.getElementById('count') as HTMLParagraphElement;

    function render(query: string) {
      const q = query.trim().toLowerCase();
      const matches = q
        ? data.filter((a) =>
            [a.title, a.description, a.pillar, a.cluster].some((field) =>
              field.toLowerCase().includes(q)
            )
          )
        : [];

      list.innerHTML = '';
      if (!q) {
        count.textContent = '';
        return;
      }
      count.textContent = matches.length
        ? `${matches.length} result${matches.length === 1 ? '' : 's'}`
        : 'No results';

      for (const a of matches) {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = a.href;
        link.className = 'result';
        link.innerHTML = `<span class="result-pillar">${a.pillar}</span><span class="result-title">${a.title}</span><span class="result-desc">${a.description}</span>`;
        li.appendChild(link);
        list.appendChild(li);
      }
    }

    input.addEventListener('input', () => render(input.value));

    const params = new URLSearchParams(location.search);
    const initial = params.get('q');
    if (initial) {
      input.value = initial;
      render(initial);
    }
    input.focus();
  </script>
</Base>

<style>
  .head { padding-block: var(--s6) var(--s4); }
  .head h1 { font-size: var(--fs-4xl); }
  .head .lede { color: var(--text-muted); margin-top: var(--s3); }

  .search-box { margin-bottom: var(--s4); }
  .search-box input {
    width: 100%;
    max-width: var(--measure);
    font-family: var(--font-body);
    font-size: var(--fs-lg);
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
  }
  .search-box input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .count { color: var(--text-muted); font-size: var(--fs-sm); margin-bottom: var(--s3); }

  .results { list-style: none; margin: 0; padding: 0; max-width: var(--measure); }
  .results li + li { border-top: 1px solid var(--border); }

  .result { display: block; padding-block: var(--s3); text-decoration: none; color: var(--text); }
  .result-pillar {
    display: block;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.2rem;
  }
  .result-title { display: block; font-family: var(--font-display); font-size: var(--fs-lg); }
  .result-desc { display: block; font-size: var(--fs-sm); color: var(--text-muted); margin-top: 0.2rem; }
  .result:hover .result-title { color: var(--accent); }
</style>
