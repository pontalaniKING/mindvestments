---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { t } from '../i18n/ui';
---

<Base title={t('contact.title')} description={t('contact.description')}>
  <section class="wrap contact">
    <h1>{t('contact.h1')}</h1>
    <p class="lede measure">{t('contact.lede')}</p>

    <dl>
      <div>
        <dt>{t('contact.general')}</dt>
        <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
      </div>
      <div>
        <dt>{t('contact.foundWrong')}</dt>
        <dd>{t('contact.foundWrongBody')}</dd>
      </div>
      <div>
        <dt>YouTube</dt>
        <dd><a href={site.youtube}>{site.youtube}</a></dd>
      </div>
    </dl>
  </section>
</Base>

<style>
  .contact { padding-block: var(--s6) var(--s7); }
  h1 { font-size: var(--fs-4xl); }
  .lede { color: var(--text-muted); margin-bottom: var(--s5); }
  dl { max-width: 560px; }
  dl > div { padding-block: var(--s3); border-top: 1px solid var(--border); }
  dt { font-size: var(--fs-xs); color: var(--text-muted); margin-bottom: 0.3rem; }
  dd { margin: 0; }
</style>
