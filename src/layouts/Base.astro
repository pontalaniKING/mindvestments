---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { t } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  /**
   * Absolute URL of a real photo for this page (article hero image, once
   * one exists in frontmatter). Left undefined everywhere today since no
   * article has a real photo yet — omitting it entirely is intentional:
   * no og:image/twitter:image tags render until a real image is passed in.
   */
  image?: string;
}

const { title, description, ogType = 'website', image } = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${t('site.tagline')}`;
const pageDescription = description ?? t('site.description');
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

// Sitewide Organization + WebSite structured data, present on every page.
// Both nodes carry a stable @id so other JSON-LD on the site (e.g. the
// Article schema's `publisher`) can reference them instead of repeating
// the same facts. Only facts already defined in src/data/site.ts are used
// here — no invented social profiles, addresses or logo.
const organizationId = `${site.url}/#organization`;
const websiteId = `${site.url}/#website`;
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: site.name,
      url: site.url
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: site.name,
      url: site.url,
      publisher: { '@id': organizationId }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en" />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {image && <meta name="twitter:image" content={image} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} is:inline />

    <meta name="theme-color" content="#224634" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>

  <body>
    <a class="skip" href="#main">{t('nav.skipToContent')}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style>
      .skip {
        position: absolute;
        inset-inline-start: -9999px;
        top: 0;
        background: var(--surface);
        padding: 0.75rem 1rem;
        z-index: 100;
      }
      .skip:focus {
        inset-inline-start: 0;
      }
    </style>
  </body>
</html>
